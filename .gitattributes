# Default: auto-detect text, normalize to LF in the repository
* text=auto eol=lf

# Files that must be LF (run/parsed on Linux containers and CI)
*.sh           text eol=lf
*.bash         text eol=lf
Dockerfile     text eol=lf
*.dockerfile   text eol=lf
*.tf           text eol=lf
*.tfvars       text eol=lf
*.hcl          text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.tpl          text eol=lf
*.js           text eol=lf
*.mjs          text eol=lf
*.cjs          text eol=lf
*.ts           text eol=lf
*.json         text eol=lf
*.md           text eol=lf

# Windows-only files keep CRLF
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

# Binary files
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.tgz          binary
*.zip          binary
